# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# The real .env is gitignored and must NEVER be committed.

# IBM-issued Claude API key + custom base URL (for answering)
ANTHROPIC_API_KEY=your-ibm-claude-key-here
ANTHROPIC_BASE_URL=https://your-ibm-base-url-here

# OpenAI API key (for embeddings via text-embedding-3-small)
OPENAI_API_KEY=your-openai-key-here
# Optional: only set this if your OpenAI access uses a custom endpoint.
# OPENAI_BASE_URL=https://your-openai-base-url-here
